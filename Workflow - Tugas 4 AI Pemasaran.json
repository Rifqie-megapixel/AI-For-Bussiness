        "mode": "runOnceForEachItem",
        "jsCode": "// Kita tidak butuh 'require' karena DateTime sudah ada secara global di n8n\nconst sekarang = DateTime.now().setZone('Asia/Jakarta');\n\n// Menggabungkan tanggal dan jam dari kolom Sheet Anda\n// Contoh format di sheet Anda: 11/02/2026 dan 11:10:00\nconst fullWaktuString = $json['Scheduled Date'] + ' ' + $json['Scheduled Time'];\n\n// Parsing string menjadi objek waktu Luxon\nconst waktuJadwal = DateTime.fromFormat(fullWaktuString, 'dd/MM/yyyy HH:mm:ss', { zone: 'Asia/Jakarta' });\n\nif (waktuJadwal <= sekarang) {\n  return $json; // Jika sudah lewat/waktunya sekarang, lanjut ke Telegram\n} else {\n  return null; // Jika belum waktunya, berhenti di sini\n}"
      },
