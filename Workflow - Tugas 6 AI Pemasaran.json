    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\n// Calculate engagement score for each item\n// Formula: Shares * 3 + Comments * 2 + Likes * 1\nconst itemsWithScore = items.map(item => {\n  const likes = item.json.Likes || 0;\n  const comments = item.json.Comments || 0;\n  const shares = item.json.Shares || 0;\n  \n  const engagementScore = (shares * 3) + (comments * 2) + likes;\n  \n  return {\n    json: {\n      jam_tayang: item.json.jam_tayang,\n      Likes: likes,\n      Comments: comments,\n      Shares: shares,\n      engagement_score: engagementScore\n    }\n  };\n});\n\nreturn itemsWithScore;"
      },
      "id": "ba11b8b6-7fde-4395-aaf0-9c117e66f53c",
      "name": "Calculate Engagement Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\n// Group by hour and calculate average engagement\nconst hourlyData = {};\n\nitems.forEach(item => {\n  const hour = item.json.jam_tayang;\n  \n  if (!hourlyData[hour]) {\n    hourlyData[hour] = {\n      total_engagement: 0,\n      count: 0\n    };\n  }\n  \n  hourlyData[hour].total_engagement += item.json.engagement_score;\n  hourlyData[hour].count += 1;\n});\n\n// Calculate averages and format output\nconst result = Object.keys(hourlyData).map(hour => {\n  const avg = hourlyData[hour].total_engagement / hourlyData[hour].count;\n  return {\n    json: {\n      jam_tayang: hour,\n      avg_engagement: Math.round(avg * 100) / 100,\n      post_count: hourlyData[hour].count\n    }\n  };\n});\n\nreturn result;"
      },
