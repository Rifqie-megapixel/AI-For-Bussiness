      "parameters": {
        "jsCode": "// Ambil semua baris dari node \"Google Sheets\"\n// **Pastikan nama node Anda adalah \"Google Sheets\"**\nconst items = $items(\"Baca Data\");\n\nlet positif = 0;\nlet negatif = 0;\nlet netral = 0;\nlet total = 0;\n\n// Loop melalui setiap baris\nfor (const item of items) {\n  // Ambil nilai dari kolom \"Sentiment\"\n  const sentiment = item.json.sentiment;\n  \n  if (sentiment === 'Positif') {\n    positif++;\n  } else if (sentiment === 'Negatif') {\n    negatif++;\n  } else if (sentiment === 'Netral') {\n    netral++;\n  }\n}\n\ntotal = items.length;\n\n// Kembalikan hasil perhitungan\nreturn {\n  total_tweets: total,\n  sentimen_positif: positif,\n  sentimen_negatif: negatif,\n  sentimen_netral: netral\n};\n"
      },
