    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ambil data dari Form Trigger\nconst formData = $('Leave Request Form').item.json;\nconst startDate = formData[\"Tanggal Mulai\"];\nconst endDate = formData[\"Tanggal Selesai\"];\n\n// Hitung durasi menggunakan Luxon\nconst start = DateTime.fromISO(startDate);\nconst end = DateTime.fromISO(endDate);\nconst durasi = end.diff(start, 'days').toObject().days + 1;\n\n// Ambil saldo cuti dari node Lookup sebelumnya (pastikan jadi angka)\nconst saldoCuti = Number($json[\"Saldo Cuti\"]);\n\n// Validasi apakah saldo mencukupi\nconst isBalanceSufficient = saldoCuti >= durasi;\n\n// Kembalikan semua data gabungan agar bisa dipakai di node selanjutnya!\nreturn {\n  ...$json, // Membawa data karyawan (Nama, Email, Saldo, Manager Email)\n  ...formData, // Membawa data isian form (Tanggal, Alasan)\n  durasi: durasi,\n  isBalanceSufficient: isBalanceSufficient,\n  sisaSaldoJikaDisetujui: saldoCuti - durasi\n};"
      },
