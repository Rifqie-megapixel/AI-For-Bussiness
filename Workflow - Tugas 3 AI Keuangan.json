    {
      "parameters": {
        "jsCode": "let totalSales = 0;\nlet totalRevenue = 0;\nlet totalPerformance = 0;\n\nfor (const item of items) {\n\n  totalSales += Number(item.json[\"Total Penjualan\"] || 0);\n\n  totalRevenue += Number(item.json[\"Pendapatan\"] || 0);\n\n  totalPerformance += Number(item.json[\"Performa\"] || 0);\n}\n\nconst avgPerformance =\nitems.length > 0\n? totalPerformance / items.length\n: 0;\n\nreturn [\n  {\n    json: {\n      Bulan: \"Mei\",\n      \"Total Penjualan\": totalSales,\n      \"Total Pendapatan\": totalRevenue,\n      \"Rata-rata Perfoma\": avgPerformance.toFixed(2)\n    }\n  }\n];"
      },
